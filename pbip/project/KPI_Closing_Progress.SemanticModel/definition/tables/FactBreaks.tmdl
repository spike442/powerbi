		sourceColumn: amt_breaks

		annotation SummarizationSetBy = User

	partition FactBreaks = m
		mode: import
		source =
				let
				    Sql = "WITH latest AS (
				    SELECT REC_ID, PERIOD, CMN_RECORD_DATE, max(VERSION) AS VERSION
				    FROM Hera_SA.KPI_REC_ALL
				    GROUP BY REC_ID, PERIOD, CMN_RECORD_DATE
				),
				unpivoted AS (
				    SELECT
				        k.PERIOD                AS period,
				        k.CMN_RECORD_DATE       AS record_date,
				        k.REC_ID                AS rec_id,
				        k.ENT_ACC               AS entity,
				        if(empty(k.CAT_NAME), '(No category)', k.CAT_NAME) AS product,
				        tupleElement(m, 1)      AS component,
				        tupleElement(m, 2)      AS threshold,
				        tupleElement(m, 3)      AS nb,
				        tupleElement(m, 4)      AS amt
				    FROM Hera_SA.KPI_REC_ALL AS k
				    ARRAY JOIN [
				        ('PNL',  'Above', NB_YPNL_BREAK_BGM_ECO_EUR_ABOVE,  AMT_YPNL_BREAK_BGM_ECO_EUR_ABOVE),
				        ('PNL',  'Below', NB_YPNL_BREAK_BGM_ECO_EUR_BELOW,  AMT_YPNL_BREAK_BGM_ECO_EUR_BELOW)
				    ] AS m
				    WHERE (k.REC_ID, k.PERIOD, k.CMN_RECORD_DATE, k.VERSION) IN (SELECT REC_ID, PERIOD, CMN_RECORD_DATE, VERSION FROM latest)
				),
				agg AS (
				    SELECT period, record_date, rec_id, entity, product, component, threshold,
				           toInt64(sum(nb))    AS nb_breaks,
				           toFloat64(sum(if(isFinite(amt), amt, 0))) AS amt_breaks
				    FROM unpivoted
				    GROUP BY period, record_date, rec_id, entity, product, component, threshold
				),
				ranked AS (
				    SELECT
				        agg.*,
				        dense_rank() OVER (ORDER BY substring(period, 1, 6) DESC)                AS closing_rank,
				        dateDiff('day', min(record_date) OVER (PARTITION BY period), record_date) + 1 AS closing_day
				    FROM agg
				)
				SELECT
				    period,
				    record_date,
				    closing_rank,
				    multiIf(closing_rank = 1, 'Current', closing_rank = 2, 'Previous', 'Older')
				        || ' (' || period || ')'                                                AS closing,
				    closing_day,
				    rec_id,
				    multiIf(positionCaseInsensitive(rec_id, 'CARRY') > 0, 'Carry',
				            positionCaseInsensitive(rec_id, 'FRZ') > 0,   'PNL',
				            rec_id)                                                             AS reconciliation,
				    entity,
				    product,
				    component,
				    threshold,
				    nb_breaks,
				    amt_breaks
				FROM ranked
				WHERE closing_rank <= 2",
				    Source = Odbc.Query("dsn=" & DsnName, Sql),
				    Typed = Table.TransformColumnTypes(Source, {
				        {"period", type text},
				        {"record_date", type date},
				        {"closing_rank", Int64.Type},
				        {"closing", type text},
				        {"closing_day", Int64.Type},
				        {"rec_id", type text},
				        {"reconciliation", type text},
				        {"entity", type text},
				        {"product", type text},
				        {"component", type text},
				        {"threshold", type text},
				        {"nb_breaks", Int64.Type},
				        {"amt_breaks", type number}
				    })
				in
				    Typed

	annotation PBI_ResultType = Table
