table FactBreaks
	lineageTag: b18a5c09-c027-55d3-bf38-838d13bcae43

	measure 'Breaks #' =
			VAR _lastDate = MAX ( FactBreaks[record_date] )
			RETURN
			    CALCULATE ( SUM ( FactBreaks[nb_breaks] ), FactBreaks[record_date] = _lastDate )
		formatString: #,0
		lineageTag: 473ae665-5858-5de6-a5d0-9151dfca1519

	measure 'Residual Amount (EUR)' =
			VAR _lastDate = MAX ( FactBreaks[record_date] )
			RETURN
			    CALCULATE ( SUM ( FactBreaks[amt_breaks] ), FactBreaks[record_date] = _lastDate )
		formatString: #,0
		lineageTag: 15f71916-0bc5-56c5-8580-f865bc710691

	measure 'Snapshot Date' =
			MAX ( FactBreaks[record_date] )
		formatString: dd/mm/yyyy
		lineageTag: 1138b32b-ddaa-5c51-b336-4a18f9bbe10e

	measure 'Current Closing Day' =
			CALCULATE (
			    MAX ( FactBreaks[closing_day] ),
			    REMOVEFILTERS ( FactBreaks[closing], FactBreaks[period], FactBreaks[record_date] ),
			    FactBreaks[closing_rank] = 1
			)
		formatString: 0
		lineageTag: 493c2b8e-85a0-505d-b526-cce3f1f5b005

	measure 'Breaks # Current' =
			CALCULATE (
			    [Breaks #],
			    REMOVEFILTERS ( FactBreaks[closing], FactBreaks[period], FactBreaks[record_date] ),
			    FactBreaks[closing_rank] = 1
			)
		formatString: #,0
		lineageTag: 9e06a967-b3dc-5ba5-b323-d7d3d47ba855

	measure 'Breaks # Previous' =
			VAR _day = [Current Closing Day]
			RETURN
			    CALCULATE (
			        [Breaks #],
			        REMOVEFILTERS ( FactBreaks[closing], FactBreaks[period], FactBreaks[record_date], FactBreaks[closing_day] ),
			        FactBreaks[closing_rank] = 2,
			        FactBreaks[closing_day] <= _day
			    )
		formatString: #,0
		lineageTag: f3a55889-bcc4-5982-bec0-748510c364e8

	measure 'Breaks # vs Previous' =
			[Breaks # Current] - [Breaks # Previous]
		formatString: #,0
		lineageTag: fff870e6-7d6f-5467-8990-cf308abb9f22

	measure 'Residual Amount Current' =
			CALCULATE (
			    [Residual Amount (EUR)],
			    REMOVEFILTERS ( FactBreaks[closing], FactBreaks[period], FactBreaks[record_date] ),
			    FactBreaks[closing_rank] = 1
			)
		formatString: #,0
		lineageTag: 931ef144-ed10-5dd9-b52d-394c65e77c8e

	measure 'Residual Amount Previous' =
			VAR _day = [Current Closing Day]
			RETURN
			    CALCULATE (
			        [Residual Amount (EUR)],
			        REMOVEFILTERS ( FactBreaks[closing], FactBreaks[period], FactBreaks[record_date], FactBreaks[closing_day] ),
			        FactBreaks[closing_rank] = 2,
			        FactBreaks[closing_day] <= _day
			    )
		formatString: #,0
		lineageTag: 0bd57ffa-a1f8-59cd-9f97-2020dc1af767

	measure 'Residual Amount vs Previous' =
			[Residual Amount Current] - [Residual Amount Previous]
		formatString: #,0
		lineageTag: 71621ed3-e407-5dd3-af5f-b1e46cc28eac

	measure 'Snapshot Subtitle' =
			"Snapshot " & FORMAT ( MAX ( FactBreaks[record_date] ), "dd/mm/yyyy" ) & "  ·  closing " & MAX ( FactBreaks[period] ) & "  ·  PNL"
		lineageTag: 816c4ec4-ba5f-5b0a-b79c-9eb434469081

	measure 'Year Subtitle' =
			"Closings of " & LEFT ( MAX ( FactBreaks[period] ), 4 ) & "  ·  latest snapshot of each closing (current closing: in progress)"
		lineageTag: 14457d4a-692b-5c1e-a9af-19e43edc9978

