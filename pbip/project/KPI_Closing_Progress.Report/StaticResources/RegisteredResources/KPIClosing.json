{
  "name": "KPI Closing",
  "dataColors": ["#1F6FB2", "#9AA6B6", "#E8A33D", "#2BA39A", "#7A5195", "#EF5675", "#4C6A92", "#B5651D"],
  "foreground": "#1B2A41",
  "foregroundNeutralSecondary": "#5B6B7F",
  "foregroundNeutralTertiary": "#8A97A8",
  "background": "#FFFFFF",
  "backgroundLight": "#F7F9FC",
  "backgroundNeutral": "#E1E6EE",
  "tableAccent": "#1F6FB2",
  "good": "#1E8E5A",
  "neutral": "#E8A33D",
  "bad": "#C0392B",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#1B2A41" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#5B6B7F" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 24, "color": "#123B5F" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 10, "color": "#1B2A41" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#EEF2F7" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#E4E9F0" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#DDE3EC" } }, "radius": 12, "width": 1 }],
        "dropShadow": [{ "show": true, "preset": "Bottom", "position": "Outer", "color": { "solid": { "color": "#1B2A41" } }, "transparency": 88, "shadowBlur": 10, "shadowDistance": 2 }],
        "padding": [{ "top": 8, "bottom": 8, "left": 12, "right": 12 }],
        "title": [{ "fontFamily": "Segoe UI Semibold", "fontSize": 11, "fontColor": { "solid": { "color": "#1B2A41" } } }]
      }
    },
    "card": {
      "*": {
        "title": [{ "alignment": "center", "fontSize": 10, "fontColor": { "solid": { "color": "#5B6B7F" } } }],
        "labels": [{ "fontFamily": "Segoe UI Semibold", "fontSize": 24, "color": { "solid": { "color": "#123B5F" } } }],
        "categoryLabels": [{ "show": false }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "fontFamily": "Segoe UI Semibold", "textSize": 10, "fontColor": { "solid": { "color": "#5B6B7F" } } }],
        "items": [{ "textSize": 10, "fontColor": { "solid": { "color": "#1B2A41" } } }]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 3, "showMarker": true, "markerSize": 4 }],
        "valueAxis": [{ "gridlineShow": true, "gridlineColor": { "solid": { "color": "#E6EBF2" } }, "gridlineStyle": "dotted", "labelColor": { "solid": { "color": "#5B6B7F" } }, "titleColor": { "solid": { "color": "#5B6B7F" } } }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#5B6B7F" } }, "titleColor": { "solid": { "color": "#5B6B7F" } } }],
        "legend": [{ "show": true, "position": "Top", "showTitle": false, "labelColor": { "solid": { "color": "#1B2A41" } } }]
      }
    }
  }
}
